{
  "$defs": {
    "Bot": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "token": {
          "format": "password",
          "title": "Token",
          "type": "string",
          "writeOnly": true
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "token"
      ],
      "title": "Bot",
      "type": "object"
    },
    "Cadences": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "default": false,
          "title": "Day",
          "type": "boolean"
        },
        "week": {
          "default": true,
          "title": "Week",
          "type": "boolean"
        },
        "month": {
          "default": true,
          "title": "Month",
          "type": "boolean"
        },
        "year": {
          "default": true,
          "title": "Year",
          "type": "boolean"
        }
      },
      "title": "Cadences",
      "type": "object"
    },
    "DetectionReporting": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "channel_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "context_words_per_side": {
          "default": 3,
          "maximum": 20,
          "minimum": 0,
          "title": "Context Words Per Side",
          "type": "integer"
        },
        "interval_seconds": {
          "default": 0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Interval Seconds",
          "type": "number"
        },
        "max_pending_instances": {
          "default": 1000,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Pending Instances",
          "type": "integer"
        },
        "max_pending_bytes": {
          "default": 1048576,
          "maximum": 4194304,
          "minimum": 1024,
          "title": "Max Pending Bytes",
          "type": "integer"
        },
        "max_pending_age_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Pending Age Seconds",
          "type": "number"
        },
        "max_pages_per_flush": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Pages Per Flush",
          "type": "integer"
        }
      },
      "title": "DetectionReporting",
      "type": "object"
    },
    "FixedAssignment": {
      "additionalProperties": false,
      "properties": {
        "bot": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Bot",
          "type": "string"
        },
        "channel_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Channel Id",
          "type": "string"
        }
      },
      "required": [
        "bot",
        "channel_id"
      ],
      "title": "FixedAssignment",
      "type": "object"
    },
    "HeadHunt": {
      "additionalProperties": false,
      "properties": {
        "all_channels": {
          "default": false,
          "title": "All Channels",
          "type": "boolean"
        },
        "excluded_channel_ids": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "title": "Excluded Channel Ids",
          "type": "array"
        },
        "interval_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Interval Seconds",
          "type": "number"
        },
        "priority_member_ids": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Priority Member Ids",
          "type": "array"
        },
        "maximum_weight": {
          "default": 10,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Maximum Weight",
          "type": "number"
        },
        "minimum_weight": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Minimum Weight",
          "type": "number"
        },
        "default_weight": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Default Weight",
          "type": "number"
        }
      },
      "title": "HeadHunt",
      "type": "object"
    },
    "Leaderboards": {
      "additionalProperties": false,
      "properties": {
        "report_channel_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Channel Id"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "sort_order": {
          "default": "descending",
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Sort Order",
          "type": "string"
        },
        "scaled": {
          "$ref": "#/$defs/Scaled"
        },
        "reports": {
          "$ref": "#/$defs/Cadences"
        },
        "suppress_empty_reports": {
          "default": true,
          "title": "Suppress Empty Reports",
          "type": "boolean"
        },
        "retention_days_when_reports_disabled": {
          "default": 30,
          "maximum": 366,
          "minimum": 1,
          "title": "Retention Days When Reports Disabled",
          "type": "integer"
        }
      },
      "title": "Leaderboards",
      "type": "object"
    },
    "Logging": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "default": "INFO",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "title": "Logging",
      "type": "object"
    },
    "Playback": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "random",
                  "first_curse"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "interval_seconds": {
                "minimum": 120
              }
            }
          }
        }
      ],
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "interval_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 5,
          "title": "Interval Seconds",
          "type": "number"
        },
        "mode": {
          "default": "random",
          "enum": [
            "random",
            "cadence",
            "first_curse"
          ],
          "title": "Mode",
          "type": "string"
        },
        "max_clip_seconds": {
          "default": 8,
          "maximum": 15,
          "minimum": 0.2,
          "title": "Max Clip Seconds",
          "type": "number"
        },
        "context_seconds": {
          "default": 1.5,
          "maximum": 5,
          "minimum": 0,
          "title": "Context Seconds",
          "type": "number"
        }
      },
      "title": "Playback",
      "type": "object"
    },
    "Privacy": {
      "additionalProperties": false,
      "properties": {
        "notice_acknowledged": {
          "default": false,
          "title": "Notice Acknowledged",
          "type": "boolean"
        },
        "context_reporting_acknowledged": {
          "default": false,
          "title": "Context Reporting Acknowledged",
          "type": "boolean"
        },
        "excluded_member_ids": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "title": "Excluded Member Ids",
          "type": "array"
        },
        "listening_notice": {
          "default": "DisCuss counts voice profanity locally; audio/transcripts are discarded; /discuss opt_out or opt_in controls your participation.",
          "maxLength": 1000,
          "minLength": 20,
          "title": "Listening Notice",
          "type": "string"
        }
      },
      "title": "Privacy",
      "type": "object"
    },
    "Profanity": {
      "additionalProperties": false,
      "properties": {
        "use_builtin_list": {
          "default": true,
          "title": "Use Builtin List",
          "type": "boolean"
        },
        "custom_words": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Custom Words",
          "type": "array"
        }
      },
      "title": "Profanity",
      "type": "object"
    },
    "Scaled": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "minimum_monitored_seconds": {
          "default": 1800,
          "maximum": 31622400,
          "minimum": 0,
          "title": "Minimum Monitored Seconds",
          "type": "number"
        }
      },
      "title": "Scaled",
      "type": "object"
    },
    "Server": {
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Server Id",
          "type": "string"
        },
        "primary_bot": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Primary Bot",
          "type": "string"
        },
        "report_channel_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Report Channel Id",
          "type": "string"
        },
        "mode": {
          "default": "head_hunt",
          "enum": [
            "head_hunt",
            "fixed_channels"
          ],
          "title": "Mode",
          "type": "string"
        },
        "monitoring_enabled": {
          "default": true,
          "title": "Monitoring Enabled",
          "type": "boolean"
        },
        "voice_channels": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "title": "Voice Channels",
          "type": "array"
        },
        "head_hunt": {
          "$ref": "#/$defs/HeadHunt"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/FixedAssignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "profanity": {
          "$ref": "#/$defs/Profanity"
        },
        "leaderboards": {
          "$ref": "#/$defs/Leaderboards"
        },
        "privacy": {
          "$ref": "#/$defs/Privacy"
        },
        "detection_reporting": {
          "$ref": "#/$defs/DetectionReporting"
        },
        "playback": {
          "$ref": "#/$defs/Playback"
        }
      },
      "required": [
        "server_id",
        "primary_bot",
        "report_channel_id"
      ],
      "title": "Server",
      "type": "object"
    },
    "Transcription": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "default": "Systran/faster-whisper-small",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "default": "536b0662742c02347bc0e980a01041f333bce120",
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "device": {
          "default": "cpu",
          "enum": [
            "cpu",
            "cuda"
          ],
          "title": "Device",
          "type": "string"
        },
        "compute_type": {
          "default": "int8",
          "enum": [
            "int8",
            "float16",
            "int8_float16",
            "float32"
          ],
          "title": "Compute Type",
          "type": "string"
        },
        "cpu_threads": {
          "default": 2,
          "maximum": 64,
          "minimum": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "en",
          "title": "Language"
        },
        "max_queue": {
          "default": 8,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Queue",
          "type": "integer"
        },
        "max_speakers": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Speakers",
          "type": "integer"
        },
        "max_buffer_bytes": {
          "default": 16777216,
          "maximum": 268435456,
          "minimum": 192000,
          "title": "Max Buffer Bytes",
          "type": "integer"
        },
        "max_chunk_seconds": {
          "default": 12,
          "maximum": 30,
          "minimum": 0.1,
          "title": "Max Chunk Seconds",
          "type": "number"
        },
        "minimum_chunk_seconds": {
          "default": 0.15,
          "maximum": 2,
          "minimum": 0.02,
          "title": "Minimum Chunk Seconds",
          "type": "number"
        },
        "silence_seconds": {
          "default": 0.5,
          "maximum": 5,
          "minimum": 0.1,
          "title": "Silence Seconds",
          "type": "number"
        },
        "vad_threshold": {
          "default": 0.003,
          "maximum": 1,
          "minimum": 0,
          "title": "Vad Threshold",
          "type": "number"
        }
      },
      "title": "Transcription",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "bots": {
      "items": {
        "$ref": "#/$defs/Bot"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Bots",
      "type": "array"
    },
    "servers": {
      "items": {
        "$ref": "#/$defs/Server"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Servers",
      "type": "array"
    },
    "state_dir": {
      "default": "state",
      "minLength": 1,
      "title": "State Dir",
      "type": "string"
    },
    "transcription": {
      "$ref": "#/$defs/Transcription"
    },
    "logging": {
      "$ref": "#/$defs/Logging"
    }
  },
  "required": [
    "bots",
    "servers"
  ],
  "title": "Config",
  "type": "object"
}
